<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>MouseClickMod</AssemblyName>
    <RootNamespace>MouseClickMod</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>8.0</LangVersion>
  </PropertyGroup>

  <!--
    Set this to your Gorilla Tag game path.
    Default assumes the game is installed at:
    C:\Program Files (x86)\Steam\steamapps\common\Gorilla Tag
  -->
  <PropertyGroup>
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\Gorilla Tag</GameDir>
    <BepInExDir>$(GameDir)\BepInEx</BepInExDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- BepInEx core -->
    <Reference Include="BepInEx">
      <HintPath>$(BepInExDir)\core\BepInEx.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExDir)\core\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- Unity engine DLLs from the game -->
    <Reference Include="UnityEngine">
      <HintPath>$(GameDir)\Gorilla Tag_Data\Managed\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameDir)\Gorilla Tag_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(GameDir)\Gorilla Tag_Data\Managed\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.InputSystemModule">
      <HintPath>$(GameDir)\Gorilla Tag_Data\Managed\UnityEngine.InputSystemModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameDir)\Gorilla Tag_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- Input System -->
    <Reference Include="Unity.InputSystem">
      <HintPath>$(GameDir)\Gorilla Tag_Data\Managed\Unity.InputSystem.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- Gorilla Tag game assemblies -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameDir)\Gorilla Tag_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>
